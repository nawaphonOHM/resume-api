# ==============================================================================
# Server Configuration (OHM9996_SERVER_*)
# ==============================================================================
OHM9996_SERVER_HOST=0.0.0.0
OHM9996_SERVER_PORT=8080
OHM9996_GIN_MODE=release
OHM9996_APP_VERSION=1.0.0
OHM9996_SERVER_DISPLAY_NAME=resume-api
OHM9996_SERVER_PROFILE_PATH=/debug/pprof
OHM9996_SERVER_READ_TIMEOUT=10s
OHM9996_SERVER_WRITE_TIMEOUT=10s
OHM9996_SERVER_IDLE_TIMEOUT=60s
OHM9996_SERVER_SHUTDOWN_TIMEOUT=10s
OHM9996_SERVER_ENABLE_ACCESS_LOG=true
OHM9996_SERVER_ENABLE_METRICS=false
OHM9996_SERVER_ENABLE_PROFILING=false

# ==============================================================================
# MongoDB Configuration (OHM9996_MONGODB_*)
# ==============================================================================
OHM9996_MONGODB_HOST=localhost
OHM9996_MONGODB_PORT=27017
OHM9996_MONGODB_PROTOCOL=mongodb
OHM9996_MONGODB_DATABASE=resume_db
OHM9996_MONGODB_USERNAME=
OHM9996_MONGODB_PASSWORD=
OHM9996_MONGODB_AUTH_SOURCE=admin
OHM9996_MONGODB_APP_NAME=resume-api
OHM9996_MONGODB_UUID_REPRESENTATION=unspecified

# ==============================================================================
# OpenTelemetry Configuration (OHM9996_OTEL_*)
# ==============================================================================
# Enable or disable OpenTelemetry distributed tracing (true/false)
OHM9996_OTEL_ENABLED=true
# Logical service name attached to exported trace spans
OHM9996_OTEL_SERVICE_NAME=resume-api
# OTLP collector receiver endpoint (e.g. localhost:4317 for gRPC or localhost:4318 for HTTP)
OHM9996_OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
# Exporter transport protocol: grpc, http, http/protobuf, http/json
OHM9996_OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# Disable TLS verification for local/internal collector communication (true/false)
OHM9996_OTEL_INSECURE=true
# Trace sampling probability between 0.0 (0%) and 1.0 (100%)
OHM9996_OTEL_SAMPLE_RATE=1.0
# Comma-separated list of route paths excluded from tracing
OHM9996_OTEL_SKIP_PATHS=/health,/ready
